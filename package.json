{
  "name": "linkedin-job-saver",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome MV3 extension: save LinkedIn jobs to Supabase, search, export.",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\" \"tests/**/*.test.mjs\"",
    "build": "esbuild src/background/service-worker.js src/library/library.js --bundle --format=esm --target=chrome110 --sourcemap --entry-names=[name] --outdir=dist",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "jsdom": "^26.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "write-excel-file": "^4.1.1"
  }
}
